{
	"name": "directus-extension-album-tracklist",
	"description": "Инлайн O2M-редактор треклиста альбома (sets.entries -> sets_entries -> perfs): поиск существующих исполнений по id, году события и названию песни",
	"icon": "album",
	"version": "1.0.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-custom-interface"
	],
	"type": "module",
	"directus:extension": {
		"type": "interface",
		"path": "dist/index.js",
		"source": "src/index.js",
		"host": "^11.0.0 || ^12.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "^17.1.4",
		"vue": "^3.5.38"
	}
}
