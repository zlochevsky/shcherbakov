{
   "baseURL": "https://zlochevsky.github.io/shcherbakov/",
   "locale": "ru",
   "title": "Песни Михаила Щербакова",
   "uglyURLs": true,
   "relativeURLs": false,
   "cascade": [
	   {
		   "target": {"path": "{/texts/**}"},
		   "type": "miscellaneous",
		   "layout": "songpage"
	   },
	   {
		   "target": {"path": "{/en/**,/eo/**,/de/**,/fr/**,/uk/**,/he/**}"},
		   "type": "miscellaneous",
		   "layout": "translation"
	   }
   ],
   "caches": {
	   "getresource": {
		   "maxAge": "10m"
	   }
   },
   "module": {
	   "mounts": [
		   {"source": "content", "target": "content"},
		   {"source": "static", "target": "static"},
		   {"source": "layouts", "target": "layouts"},
		   {"source": "assets", "target": "assets"},
		   {"source": "data", "target": "data"},
		   {"source": "i18n", "target": "i18n"},
		   {"source": "archetypes", "target": "archetypes"},
		   {"source": "private/content", "target": "content"},
		   {"source": "private/static", "target": "static"}
	   ]
   },
   "params": {
	   "subtitle": "неофициальная страница",
	   "canonicalBase": "",
	   "directus": {
		   "url": "https://db.sch.com.ru/",
		   "songs" : "items/works/",
		   "limit": "limit=-1",
		   "fields": "fields=id,sort,incipit,fincipit,name,fname,date,edit,hidden,is_poem,is_new,noindex",
		   "sort": "sort=sort",
		   "cache": "cache=false"
	   }
   },
   "markup": {
	   "goldmark": {
		   "renderer": {
			  "unsafe": true
		   },
		   "parser": {
			   "wrapStandAloneImageWithinParagraph": false,
			   "attribute": {
				   "block": true
			   }
		   },
		   "extensions": {
			   "typographer": {
				   "ellipsis": "..."
			   }
		   }
	   }
   },
   "frontmatter": {
	"lastmod": [
		"lastmod"
	]
   },
	"disableKinds": ["taxonomy", "term", "section", "RSS"],
	"build": {
		"_merge": "deep"
	}
}

