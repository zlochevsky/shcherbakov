{
   "baseURL": "https://zlochevsky.github.io/shcherbakov/",
   "locale": "ru",
   "title": "Песни Михаила Щербакова",
   "uglyURLs": true,
   "relativeURLs": false,
   "cascade": [
	   {
		   "target": {"path": "{/texts/**}"},
		   "type": "miscellaneous",
		   "layout": "songpage"
	   },
	   {
		   "target": {"path": "{/en/**,/eo/**,/de/**,/fr/**,/uk/**,/he/**}"},
		   "type": "miscellaneous",
		   "layout": "translation"
	   }
   ],
   "caches": {
	   "getresource": {
		   "maxAge": "10m"
	   }
   },
   "params": {
	   "subtitle": "неофициальная страница",
	   "canonicalBase": "",
	   "directus": {
		   "url": "https://db.sch.com.ru/",
		   "songs" : "items/works/",
		   "limit": "limit=-1",
		   "fields": "fields=id,sort,incipit,fincipit,name,qualifier,date,edit,hidden,is_poem,is_new,noindex",
		   "sort": "sort=sort",
		   "cache": "cache=false"
	   }
   },
   "markup": {
	   "goldmark": {
		   "renderer": {
			  "unsafe": true
		   },
		   "parser": {
			   "wrapStandAloneImageWithinParagraph": false,
			   "attribute": {
				   "block": true
			   }
		   },
		   "extensions": {
			   "typographer": {
				   "ellipsis": "..."
			   }
		   }
	   }
   },
   "frontmatter": {
	"lastmod": [
		"lastmod"
	]
   },
	"disableKinds": ["taxonomy", "term", "section", "RSS"],
	"build": {
		"_merge": "deep"
	}
}

