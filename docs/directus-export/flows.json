          "code": "module.exports = async function(data) {\n  const payload = data.$trigger.payload;\n  if (payload.date) {\n    const d = new Date(payload.date);\n    const days = [\"вс\", \"пн\", \"вт\", \"ср\", \"чт\", \"пт\", \"сб\"];\n    payload.year = d.getUTCFullYear();\n    payload.dw = days[d.getUTCDay()];\n  }\n  return payload;\n};"
