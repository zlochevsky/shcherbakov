        "key": "keysForLookup",
        "name": "Run Script",
        "options": {
          "code": "module.exports = async function(data) {\n  // при создании ключей нет: -1 не совпадёт ни с одной ссылкой\n  const keys = data.$trigger.keys;\n  return Array.isArray(keys) && keys.length ? keys : [-1];\n};"
        },
