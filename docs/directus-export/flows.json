    "description": "Новая запись works/translations → пустой файл текста в репозитории сайта (content/texts/<год>/<id>.md, content/<язык>/<id>.md), чтобы текст сразу можно было вписать в /admin/ (Sveltia). Существующий файл не перезаписывается (GitHub отвечает 422).",
    "icon": "note_add",
    "id": "49f3616f-dfdd-4221-9772-62761f68d9ca",
    "name": "Create text file for new song or translation",
    "operation": "27dded54-0865-4ded-8375-d91bd7b3bdfd",
    "operations": [
      {
        "date_created": "2026-10-07T15:53:29.490Z",
        "flow": "49f3616f-dfdd-4221-9772-62761f68d9ca",
        "id": "27dded54-0865-4ded-8375-d91bd7b3bdfd",
        "key": "filePath",
        "name": "Путь файла",
        "options": {
          "code": "module.exports = async function(data) {\n  // Новая песня (works) или перевод (translations) — путь пустого файла для текста в репозитории сайта.\n  // Песня: content/texts/<|date|>/<id>.md (date бывает отрицательной — неточная датировка); без года файл не создаём.\n  // Перевод: content/<язык>/<id>.md — только для языков, у которых на сайте есть раздел.\n  const t = data.$trigger;\n  const p = t.payload || {};\n  const id = String(t.key || p.id || '');\n  const langs = ['en', 'de', 'eo', 'he', 'uk', 'fr'];\n  let path = null, what = '';\n  if (/^[a-z0-9_-]+$/i.test(id)) {\n    if (t.collection === 'works' && p.date !== null && p.date !== undefined && p.date !== '' && !isNaN(Number(p.date))) {\n      path = `content/texts/${Math.abs(Number(p.date))}/${id}.md`; what = 'song';\n    }\n    const lang = p.languages_id && typeof p.languages_id === 'object' ? p.languages_id.id : p.languages_id;\n    if (t.collection === 'translations' && langs.includes(lang)) {\n      path = `content/${lang}/${id}.md`; what = 'translation';\n    }\n  }\n  return { path, message: path ? `New ${what} ${id}: empty text file, created by Directus` : null };\n};"
        },
        "position_x": "19",
        "position_y": "1",
        "reject": null,
        "resolve": "be9b6cc1-4975-444c-baf2-0d077ec52125",
        "type": "exec",
        "user_created": null
      },
