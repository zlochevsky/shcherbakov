        "flow": "79f4a840-6b3f-4b66-b1c3-284e9ea8fee6",
        "id": "c60fc471-1ffa-49f3-b2cc-be92e6c1455e",
        "key": "validate",
        "name": "Run Script",
        "options": {
          "code": "module.exports = async function(data) {\n  const payload = data.$trigger.payload || {};\n  const owners = ['releases_id', 'recordings_id', 'performers_id', 'translators_id'];\n  const isCreate = String(data.$trigger.event || '').endsWith('create');\n  const rows = isCreate ? [{}] : (data.existing || []);\n  for (const row of rows) {\n    const merged = Object.assign({}, row, payload);\n    const n = owners.filter(k => merged[k] !== null && merged[k] !== undefined && merged[k] !== '').length;\n    if (n !== 1) {\n      throw new Error('Ссылка должна принадлежать ровно одному объекту: изданию, записи, исполнителю или переводчику. Добавляйте ссылки из формы этого объекта (список «Ссылки»).');\n    }\n  }\n  return payload;\n};"
        },
        "position_x": "55",
        "position_y": "1",
        "reject": null,
        "resolve": null,
        "type": "exec",
        "user_created": null
      }
    ],
